# ==============================================================================
# Atlas Options positioning Platform Environment Configuration Template
# Copy this file to '.env' and modify the values for your local setup.
# ==============================================================================

# General Configuration
PROJECT_NAME="Atlas Options Positioning Analytics"
ENV=development

# Database Settings (TimescaleDB)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:secretpassword@localhost:5432/atlas

# Cache & Message Broker Settings (Redis)
# Format: redis://hostname:port/db_number
REDIS_URL=redis://localhost:6379/0

# Polygon.io API Settings
# Get your key at https://polygon.io
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_MAX_RETRIES=3
POLYGON_BACKOFF_FACTOR=0.5

# Data Ingestion Engine Settings
# Interval in minutes to poll the options chains
INGEST_INTERVAL_MINUTES=1
# Comma-separated list of active symbols to ingest and visualize
SUPPORTED_TICKERS=SPY,QQQ,IWM
